# Copy to frontend/.env for local dev — .env is gitignored.

# CRA dev server port.
PORT=4001

# Backend FastAPI port — used by electron.js to wait for the backend before
# opening the window, and by REACT_APP_API_URL below.
BACKEND_PORT=9001

# Must match the backend's ZMQ_PORT (see backend/.env.example) so Electron's
# ZMQ SUB connects to the right socket. If another dev is running the app on
# the same host at the same time, pick a different port here (and match it
# on the backend).
ZMQ_PORT=5558

REACT_APP_API_URL=http://localhost:9001/api/v1
