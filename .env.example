# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# GitHub fine-grained PAT for the GitHub MCP server.
# Create at: github.com -> Settings -> Developer Settings -> Fine-grained tokens
# Required scopes: repo (read/write), workflow, PR create + merge
GITHUB_PAT=

# PostgreSQL connection string for the read-only MCP server.
# Use a dedicated read-only role, not your main app user:
#   CREATE ROLE claude_readonly LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE osm TO claude_readonly;
#   GRANT USAGE ON SCHEMA public TO claude_readonly;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO claude_readonly;
DATABASE_URL=postgresql://claude_readonly:PASSWORD@localhost:5432/osm
