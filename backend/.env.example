# Copy to backend/.env for local (non-Docker) dev — .env is gitignored.
DATABASE_URL=postgresql://raph:raph123@localhost:5440/osm_dev
POSTGRES_PORT=5440

# Port the backend's ZMQ PUB socket binds to (live camera feed / inspection
# results -> Electron main process). If another dev is running the app on
# the same host at the same time, pick a different port here.
ZMQ_PORT=5558

# Redis connection -- host/port, not machine_config.yaml, same reasoning as
# ZMQ_PORT above (local service port, not machine-specific config).
REDIS_HOST=localhost
REDIS_PORT=9379
